@model MovieTracker.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1>Delete Movie</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this movie?
</div>

<h3>@Model.Title</h3>

<dl class="row">
    <dt class="col-sm-3">Release Year</dt>
    <dd class="col-sm-9">@Model.ReleaseYear</dd>

    <dt class="col-sm-3">Genre</dt>
    <dd class="col-sm-9">@Model.Genre.Name</dd>

    <dt class="col-sm-3">Director</dt>
    <dd class="col-sm-9">@Model.Director.Name</dd>

    <dt class="col-sm-3">Rating</dt>
    <dd class="col-sm-9">@Model.Rating</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>