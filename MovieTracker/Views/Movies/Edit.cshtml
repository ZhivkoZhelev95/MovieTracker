@model MovieTracker.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<h1>Edit Movie</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ReleaseYear" class="form-label"></label>
        <input asp-for="ReleaseYear" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Rating" class="form-label"></label>
        <input asp-for="Rating" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsWatched" class="form-check-input" />
        <label asp-for="IsWatched" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="GenreId" class="form-label">Genre</label>
        <select asp-for="GenreId" asp-items="ViewBag.Genres" class="form-select">
            <option value="">-- Select Genre --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="DirectorId" class="form-label">Director</label>
        <select asp-for="DirectorId" asp-items="ViewBag.Directors" class="form-select">
            <option value="">-- Select Director --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Save Changes</button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>