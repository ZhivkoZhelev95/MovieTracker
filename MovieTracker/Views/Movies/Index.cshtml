@model IEnumerable<MovieTracker.Models.Movie>

@{
    ViewData["Title"] = "My Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">🎬 My Movie Collection</h1>
        <p class="text-secondary">
            Keep track of the movies you've watched and want to watch.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-danger">
        + Add Movie
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary text-center">
        <h4>Your collection is empty!</h4>
        <p>Start building your movie collection today.</p>

        <a asp-action="Create" class="btn btn-danger">
            Add Your First Movie
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-5 g-3">

        @foreach (var movie in Model)
        {
            <div class="col">

                <div class="card bg-black text-light border-secondary h-100 shadow">

                    @if (!string.IsNullOrEmpty(movie.ImageUrl))
                    {
                        <img src="@movie.ImageUrl"
                             class="card-img-top"
                             alt="@movie.Title"
                             style="height: 250px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary d-flex align-items-center justify-content-center"
                             style="height: 250px;">
                            <span class="fs-1">🎬</span>
                        </div>
                    }

                    <div class="card-body">

                        <h5 class="card-title fw-bold">
                            @movie.Title
                        </h5>

                        <p class="text-secondary mb-2">
                            @movie.ReleaseYear
                        </p>

                        <p class="mb-2">
                            <strong>Genre:</strong> @movie.Genre?.Name
                        </p>

                        <p class="mb-2">
                            <strong>Director:</strong> @movie.Director?.Name
                        </p>

                        <p class="mb-2">
                            ⭐ <strong>Rating:</strong> @movie.Rating / 10
                        </p>

                        @if (movie.IsWatched)
                        {
                            <span class="badge bg-success">
                                ✓ Watched
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Not Watched
                            </span>
                        }

                    </div>

                    <div class="card-footer bg-black border-secondary d-flex justify-content-center gap-1 p-2">

                        <a asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="btn btn-outline-info btn-sm flex-fill">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@movie.Id"
                           class="btn btn-outline-warning btn-sm flex-fill">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@movie.Id"
                           class="btn btn-outline-danger btn-sm flex-fill">
                            Delete
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}